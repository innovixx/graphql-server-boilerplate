{
  "name": "graphql-server-boilerplate",
  "version": "0.0.0",
  "description": "This GraphQL server boilerplate provides a basic structure for building servers.",
  "repository": "git@github.com:innovixx/graphql-server-boilerplate.git",
  "author": "Innovixx <support@innovixx.co.uk>",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:where-types && pnpm generate:graphql-schema && nodemon --watch src --ext ts,tsx --exec tsx src/index.ts",
    "build": "pnpm generate:where-types && pnpm generate:graphql-schema && pnpm generate:openapi && pnpm tsc && pnpm copyfiles",
    "serve": "node ./dist/index.js",
    "cleanDev": "pnpm db:reset && tsx ./src/seed/index.ts && pnpm dev",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:migrate:main": "npx prisma migrate dev && npx prisma generate",
    "db:migrate:main:prod": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset --force",
    "generate:openapi": "npx tsx src/bin/generateOpenApi/index.ts",
    "generate:where-types": "npx tsx src/bin/generateWhereTypes/index.ts",
    "generate:graphql-schema": "npx tsx src/bin/generateGraphqlSchema/index.ts",
    "copyfiles": "copyfiles -u 1 \"src/**/*.json\" \"src/**/*.txt\" \"src/**/*.png\" \"src/**/*.ttf\" \"src/**/*.graphql\" dist/",
    "lint": "eslint ./src/**/*.{js,jsx,ts,tsx,graphql}",
    "lint-staged": "lint-staged --verbose",
    "prepare": "if [ -d node_modules/husky ]; then husky; fi"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.2.7",
    "@graphql-tools/schema": "^10.1.4",
    "@graphql-tools/utils": "^12.0.4",
    "@innovixx/api-kit": "^0.0.18",
    "@innovixx/prisma-gql-generator": "^0.0.7",
    "@parcel/watcher": "^2.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-tag": "^2.12.7",
    "helmet": "^8.3.0",
    "lodash.merge": "^4.6.2",
    "prisma": "^7.9.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@innovixx/eslint-config": "^3.0.12",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serve-static": "2.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "copyfiles": "^2.4.1",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "typescript-json-schema": "^0.68.0"
  },
  "lint-staged": {
    "**/*.graphql": "eslint",
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --quiet",
      "bash -c tsc"
    ]
  }
}